# Copy this file to .env.local and fill in your local values.
# Do not commit .env.local.
# For the local demo database, use the PostgreSQL container started by
# `npm.cmd run local:setup`.

AUTH_SEED_EMAIL=""
AUTH_SEED_PASSWORD=""
AUTH_SEED_PASSWORD_HASH=""
DATABASE_URL="postgresql://safeviate:safeviate-local@localhost:5433/safeviate"
DATABASE_URL_UNPOOLED="postgresql://safeviate:safeviate-local@localhost:5433/safeviate"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Base64-encoded 32-byte key used to encrypt TOTP secrets. Keep this stable after MFA enrolment.
MFA_ENCRYPTION_KEY=""
NEXTAUTH_URL="http://localhost:9002"
NEXT_PUBLIC_APP_URL="http://localhost:9002"
Safeviate_AI_KEY=""
OPENAI_API_KEY=""
OPENAIP_API_KEY=""
NEXT_PUBLIC_MAPLIBRE_LIGHT_STYLE_URL=""
NEXT_PUBLIC_MAPLIBRE_SATELLITE_STYLE_URL=""
NEXT_PUBLIC_OPENAIP_VECTOR_TILE_URL=""
RESEND_API_KEY=""
MAIL_FROM=""
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="uploads"
